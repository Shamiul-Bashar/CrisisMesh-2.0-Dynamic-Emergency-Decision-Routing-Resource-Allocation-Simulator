# Frontend (Vercel build-time)
VITE_API_BASE_URL=https://your-crisismesh-backend.up.railway.app

# Backend (Railway runtime)
AUTHOR_RECOVERY_EMAIL=your-recovery@gmail.com
ALLOWED_ORIGINS=https://your-crisismesh.vercel.app

# Preferred hosted email transport: HTTPS API (works on Railway Hobby/Trial)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=CrisisMesh 2.0 <onboarding@resend.dev>

# Optional local SMTP fallback. Railway Hobby/Trial blocks outbound SMTP.
EMAIL_USER=your-sender@gmail.com
EMAIL_APP_PASSWORD=your-gmail-app-password

# Optional local override. The Docker image uses backend/build/crisismesh_simulation_cli by default.
# SIMULATION_CLI_PATH=/absolute/path/to/crisismesh_simulation_cli
